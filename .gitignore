# ==========================================
# MediScript-AI .gitignore
# ==========================================

# Data Governance & PHI Protection (CRITICAL)
# Raw unredacted patient data must NEVER be committed
data/raw/*
!data/raw/.gitkeep

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/

# Node / Frontend
node_modules/
.next/
out/
.npm/
.yarn/
*.log

# IDE & OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
